# Copy this file to ".env" and fill in ONE provider's key. NEVER commit the real .env file.

# Which provider to use: anthropic | openai | gemini   (default: anthropic)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here

# Optional: override the default model name (check your provider's current model list;
# defaults are set in src/config.py and may be retired by the provider over time).
# Gemini example (Google retires old models, so check ai.google.dev/gemini-api/docs/models):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your real key
# LLM_MODEL=gemini-3.6-flash
# LLM_MODEL=
